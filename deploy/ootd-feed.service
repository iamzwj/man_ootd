[Unit]
Description=OOTD on-demand image discovery (metadata only)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=PORT=8794
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /var/www/ootd/public/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=100M
TasksMax=48
[Install]
WantedBy=multi-user.target
