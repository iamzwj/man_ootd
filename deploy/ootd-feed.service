[Unit]
Description=OOTD on-demand image discovery (visual screening, no photo storage)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=PORT=8794
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OOTD_VISION_ROOT=/var/lib/ootd/vision
ExecStart=/opt/ootd-venv/bin/python /var/www/ootd/public/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=600M
TasksMax=96
[Install]
WantedBy=multi-user.target
